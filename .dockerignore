# Keep secrets, runtime state, and cruft out of the image (COPY . .).
.env
.env.*
!.env.example
data/
config/
*.pem

# VCS / editor
.git/
.gitignore
.cursor/
.vscode/
.idea/

# Python caches & test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/
htmlcov/
.coverage

# Frontend: build it fresh in the node stage; never ship node_modules or a
# stale local build into the image context.
ui/web/node_modules/
ui/web/dist/
ui/static/dist/

# Docs/dev-only — not needed at runtime
README.md
requirements-dev.txt
pytest.ini
