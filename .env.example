# ============================================================
# Plutus MCP Server — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Web UI login. First run seeds admin/adminadmin (change it in Settings → Users);
# set these to pin your own. The MCP transport is protected separately by
# MCP_BEARER_TOKEN / MCP_REQUIRE_BEARER below.
UI_USERNAME=admin
UI_PASSWORD=change_this_password

# --- Jellyfin ---
JELLYFIN_URL=http://192.168.1.111:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=  # Get from Jellyfin Dashboard > Users > click user > copy ID from URL

# --- Sonarr ---
SONARR_URL=http://192.168.1.111:8989
SONARR_API_KEY=

# --- Radarr ---
RADARR_URL=http://192.168.1.111:7878
RADARR_API_KEY=

# --- Lidarr ---
LIDARR_URL=http://192.168.1.111:8686
LIDARR_API_KEY=

# --- Jellyseerr ---
JELLYSEERR_URL=http://192.168.1.111:5055
JELLYSEERR_API_KEY=

# --- qBittorrent ---
QBITTORRENT_URL=http://192.168.1.111:8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=

# --- Immich ---
IMMICH_URL=http://192.168.1.111:2283
IMMICH_API_KEY=

# --- Home Assistant ---
HA_URL=http://192.168.1.X:8123  # Your HA internal URL
HA_TOKEN=  # Long-lived access token from HA Profile > Security

# --- Habitica ---
HABITICA_URL=http://192.168.1.111:3030
HABITICA_USER_ID=
HABITICA_API_TOKEN=

# --- Nextcloud ---
NEXTCLOUD_URL=http://192.168.1.111:4444/nextcloud
NEXTCLOUD_USERNAME=friso
NEXTCLOUD_PASSWORD=

# --- Ntfy ---
NTFY_URL=http://192.168.1.111:5050
NTFY_USERNAME=friso
NTFY_PASSWORD=
NTFY_DEFAULT_TOPIC=assistant

# --- Docker ---
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_WRITE_ENABLED=false  # Set to true to allow start/stop/restart

# --- OMV ---
OMV_URL=http://192.168.1.111
OMV_USERNAME=admin
OMV_PASSWORD=

# --- MCP Auth (optional - leave empty to disable) ---
MCP_BEARER_TOKEN=
# When true, MCP HTTP (/mcp) requires Authorization: Bearer <MCP_BEARER_TOKEN>
MCP_REQUIRE_BEARER=false
# HTTPS base from Tailscale serve/funnel or reverse proxy (no path). MCP URL becomes PUBLIC_MCP_BASE + /mcp
PUBLIC_MCP_BASE=
# Hostname shown in UI + wizard (LAN)
MCP_LAN_HOST=192.168.1.111

# --- Syncthing ---
SYNCTHING_URL=http://192.168.1.111:8384
SYNCTHING_API_KEY=

# --- SMTP / Proton Bridge ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=friso@primephoto.eu
SMTP_PASSWORD=

# --- ComfyUI ---
COMFYUI_URL=http://192.168.1.X:8188

# --- Obsidian REST API ---
OBSIDIAN_URL=http://192.168.1.5:27124
OBSIDIAN_API_KEY=  # From Obsidian Settings > Local REST API

# --- n8n API ---
N8N_URL=http://192.168.1.111:5678
N8N_API_KEY=  # From n8n Settings > API > Create API Key

# --- Uptime Kuma ---
UPTIME_KUMA_URL=http://192.168.1.111:3001

# --- Filesystem ---
# Comma-separated list of paths the MCP server is allowed to read
FILESYSTEM_ALLOWED_PATHS=/01_Offene_Jobs,/mnt/omv_share

# --- Debugging (optional) ---
# Echo upstream HTTP response bodies and raw exception text into tool errors.
# Off by default — those can leak secrets/tokens/hostnames into transcripts.
PLUTUS_VERBOSE_ERRORS=false

# --- Updates (optional) ---
# Settings → Updates: compares VERSION to github.com/repos/<owner>/<repo>/releases/latest
PLUTUS_UPDATES_REPO=
# Raises the anonymous 60/hour limit to 5000/hour, and turns the GitHub tools
# into your account's own client: private repos, code search, Actions,
# notifications, and commits/issues/PRs/comments made as you. A classic token
# wants `repo` (plus `workflow` for Actions); a fine-grained one wants
# Contents/Issues/Pull requests read-write on the repositories the agent should
# reach. Omit it entirely for public read-only research.
GITHUB_TOKEN=

# --- Custom dashboard cards ---
# Prefer editing via Settings UI; optionally copy data/custom_integrations.example.json
# to data/custom_integrations.json and add env vars (e.g. MYAPP_URL=...) alongside.

# --- OpenRouter (optional) ---
# The API key itself is stored per account in Settings → AI providers, not here.
# These two only decide how requests identify this app on your OpenRouter
# activity page. There is no icon setting: OpenRouter renders the favicon of
# whatever OPENROUTER_APP_URL points at, so that URL *is* the icon.
OPENROUTER_APP_NAME=Plutus MCP Manager
OPENROUTER_APP_URL=https://github.com/Thefrizzy1/MCP-Manager

# --- Reddit (optional) ---
# The social tools read public feeds without any of this. With a "script" app
# from https://www.reddit.com/prefs/apps they read oauth.reddit.com *as you*:
# scores and comment counts, a far higher rate limit, and your own subscriptions,
# front page and saved posts. All four fields are needed, or it stays anonymous.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=

# --- Firecrawl (optional) ---
# Renders JavaScript and returns Markdown — the pages web_fetch comes back empty
# on. With a key, web_fetch also upgrades itself automatically when a page turns
# out to be an empty shell. FIRECRAWL_API_URL points at a self-hosted instance
# (Firecrawl is open source); leave it blank for the hosted API.
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
